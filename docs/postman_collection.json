{
  "info": {
    "name": "Prueba Técnica API",
    "description": "API REST para gestión de productos con precios multi-moneda",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('access_token', jsonData.body.access_token);",
                  "    pm.test('Login exitoso', function() {",
                  "        pm.expect(jsonData.body.access_token).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "Autentica un usuario y devuelve un token de acceso"
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products?per_page=10&page=1&sort_by=id&sort_direction=desc",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "per_page",
                  "value": "10",
                  "description": "Número de productos por página"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número de página"
                },
                {
                  "key": "sort_by",
                  "value": "id",
                  "description": "Campo para ordenar"
                },
                {
                  "key": "sort_direction",
                  "value": "desc",
                  "description": "Dirección del ordenamiento"
                }
              ]
            },
            "description": "Obtiene una lista paginada de productos"
          }
        },
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('product_id', jsonData.body.product.id);",
                  "    pm.test('Producto creado', function() {",
                  "        pm.expect(jsonData.body.product.id).to.be.a('number');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Producto de ejemplo\",\n  \"description\": \"Descripción detallada del producto\",\n  \"price\": 100.00,\n  \"currency_id\": {{currency_id}},\n  \"tax_cost\": 16.00,\n  \"manufacturing_cost\": 50.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            },
            "description": "Crea un nuevo producto"
          }
        },
        {
          "name": "Obtener producto",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}"]
            },
            "description": "Obtiene un producto específico por ID"
          }
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Producto actualizado\",\n  \"description\": \"Descripción actualizada\",\n  \"price\": 150.00,\n  \"currency_id\": {{currency_id}},\n  \"tax_cost\": 20.00,\n  \"manufacturing_cost\": 60.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}"]
            },
            "description": "Actualiza un producto existente"
          }
        },
        {
          "name": "Eliminar producto",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}"]
            },
            "description": "Elimina un producto (soft delete)"
          }
        }
      ]
    },
    {
      "name": "Divisas",
      "item": [
        {
          "name": "Listar divisas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/divisas?per_page=10&page=1&sort_by=id&sort_direction=asc",
              "host": ["{{base_url}}"],
              "path": ["divisas"],
              "query": [
                {
                  "key": "per_page",
                  "value": "10",
                  "description": "Número de divisas por página"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número de página"
                },
                {
                  "key": "sort_by",
                  "value": "id",
                  "description": "Campo para ordenar (id, name, symbol, exchange_rate, created_at, updated_at)"
                },
                {
                  "key": "sort_direction",
                  "value": "asc",
                  "description": "Dirección del ordenamiento (asc, desc)"
                }
              ]
            },
            "description": "Obtiene una lista paginada de divisas"
          }
        },
        {
          "name": "Crear divisa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('currency_id', jsonData.body.divisa.id);",
                  "    pm.test('Divisa creada', function() {",
                  "        pm.expect(jsonData.body.divisa.id).to.be.a('number');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Euro\",\n  \"symbol\": \"€\",\n  \"exchange_rate\": 0.92000000\n}"
            },
            "url": {
              "raw": "{{base_url}}/divisas",
              "host": ["{{base_url}}"],
              "path": ["divisas"]
            },
            "description": "Crea una nueva divisa"
          }
        }
      ]
    },
    {
      "name": "Precios",
      "item": [
        {
          "name": "Listar precios de un producto",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}/prices?per_page=10&page=1&sort_by=created_at&sort_direction=desc",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}", "prices"],
              "query": [
                {
                  "key": "per_page",
                  "value": "10",
                  "description": "Número de precios por página"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número de página"
                },
                {
                  "key": "sort_by",
                  "value": "created_at",
                  "description": "Campo para ordenar"
                },
                {
                  "key": "sort_direction",
                  "value": "desc",
                  "description": "Dirección del ordenamiento"
                }
              ]
            },
            "description": "Obtiene una lista paginada de precios para un producto específico"
          }
        },
        {
          "name": "Crear precio",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('price_id', jsonData.body.price.id);",
                  "    pm.test('Precio creado', function() {",
                  "        pm.expect(jsonData.body.price.id).to.be.a('number');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 120.00,\n  \"currency_id\": {{currency_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}/prices",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}", "prices"]
            },
            "description": "Crea un nuevo precio para un producto"
          }
        }
      ]
    }
  ]
}
